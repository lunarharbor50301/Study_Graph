# Global provider: deepseek (public API, default) or tacc (Qwen).
STUDYGRAPH_LLM_PROVIDER=deepseek

# Optional per-feature overrides.
STUDYGRAPH_GENERATION_PROVIDER=
STUDYGRAPH_TUTOR_PROVIDER=

# Optional: set 0 to skip the TACC /v1/models preflight.
STUDYGRAPH_PROVIDER_HEALTHCHECK=1

# DeepSeek public API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# TACC Qwen, only needed when the provider is tacc.
QWEN_BASE_URL=http://127.0.0.1:18024/v1
QWEN_MODEL=qwen3.8-27b
QWEN_API_KEY=local
NO_PROXY=localhost,127.0.0.1
